# Environment (development | production)
APP_ENV=development

# Database Connection (SQLite locally, PostgreSQL in production e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./nxtwave_growth.db

# Frontend Domain for CORS and headers (e.g. https://nxtwave-growth.vercel.app)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Email Provider Settings (console | smtp)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_TLS=true

